<!-- res/layout/receipt_layout.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Optional Logo -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvPartyName"
            style="@style/TextTitleUrdu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:text="Milk Sales Report"
            android:textColor="@color/purchase_color"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            style="@style/TextTitleUrdu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:textColor="@color/blue_700"
            android:textSize="10sp"
            tools:text="Receipt ID: #12345" />

        <TextView
            android:id="@+id/tvDateRange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textColor="#000000"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="23 Oct - 25 Oct" />

        <!-- Table Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/blue_100"
            android:orientation="horizontal"
            android:paddingHorizontal="2dp"
            android:paddingVertical="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:gravity="start"
                android:text="Customer"
                android:textColor="#0D47A1"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Qty"
                android:textColor="#0D47A1"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Deduction"
                android:textColor="#0D47A1"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Rate"
                android:textColor="#0D47A1"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="Amount"
                android:textColor="#0D47A1"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Paid"
                android:textColor="#0D47A1"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Balance"
                android:textColor="#0D47A1"
                android:textSize="8sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Table Rows -->
        <LinearLayout
            android:id="@+id/recordContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="?android:attr/dividerHorizontal"
            android:orientation="vertical"
            android:showDividers="middle" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:background="#1976D2" />

        <!-- Summary -->
        <TextView
            style="@style/PdfSummaryTextStyle"
            android:text="Summary"
            android:textColor="#2E7D32"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_edittext_readable"
            android:padding="4dp">




            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                tools:ignore="UselessParent">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        style="@style/PdfSummaryTextStyle"
                        android:text="Total Quantity"
                        android:textColor="#616161" />

                    <TextView
                        android:id="@+id/tvTotalQuantity"
                        style="@style/PdfSummaryTextStyle"
                        android:textColor="#000000"
                        tools:text="24" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        style="@style/PdfSummaryTextStyle"
                        android:text="Total Deduction"
                        android:textColor="#616161" />

                    <TextView
                        android:id="@+id/tvTotalDeduction"
                        style="@style/PdfSummaryTextStyle"
                        android:textColor="#000000"
                        tools:text="24" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        style="@style/PdfSummaryTextStyle"
                        android:text="Total Amount"
                        android:textColor="#616161" />

                    <TextView
                        android:id="@+id/tvSummaryTotalAmount"
                        style="@style/PdfSummaryTextStyle"
                        android:textColor="#000000"
                        tools:text="15,050.00" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        style="@style/PdfSummaryTextStyle"
                        android:text="Total Paid"
                        android:textColor="#616161" />

                    <TextView
                        android:id="@+id/tvSummaryTotalPaid"
                        style="@style/PdfSummaryTextStyle"
                        android:textColor="#2E7D32"
                        tools:text="10,000.00" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        style="@style/PdfSummaryTextStyle"
                        android:text="Balance"
                        android:textColor="#616161" />

                    <TextView
                        android:id="@+id/tvSummaryBalance"
                        style="@style/PdfSummaryTextStyle"
                        android:textColor="#C62828"
                        tools:text="5,050.00" />
                </LinearLayout>

            </LinearLayout>


        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:id="@+id/tvFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/blue_100"
            android:textSize="8sp"
            android:textStyle="bold"
            tools:text="Thank you for your business!" />
    </LinearLayout>
</ScrollView>
