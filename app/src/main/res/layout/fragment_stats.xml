<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/analyticsScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Milk Ledger Analytics"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:paddingBottom="12dp" />

        <!-- Period Selector -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <RadioGroup
                android:id="@+id/rgPeriod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="8dp">

                <RadioButton
                    android:id="@+id/rbWeekly"
                    android:text="Weekly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:layout_marginEnd="8dp" />

                <RadioButton
                    android:id="@+id/rbMonthly"
                    android:text="Monthly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp" />

                <RadioButton
                    android:id="@+id/rbYearly"
                    android:text="Yearly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp" />

                <RadioButton
                    android:id="@+id/rbCustom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Custom" />
            </RadioGroup>
        </com.google.android.material.card.MaterialCardView>

        <!-- Sales Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSales"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/teal_200">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:text="Total Sales"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    style="@style/TitleText"
                    android:textColor="@color/teal_700" />

                <TextView
                    android:id="@+id/tvSalesTotal"
                    android:text="Rs. 0.00"
                    style="@style/TitleText"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:paddingTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Purchases Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPurchases"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/orange_200">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:text="Total Purchases"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    style="@style/TitleText"
                    android:textColor="@color/orange_700" />

                <TextView
                    android:id="@+id/tvPurchaseTotal"
                    android:text="Rs. 0.00"
                    style="@style/TitleText"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:paddingTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Expenses Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardExpenses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/blue_200">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:text="Total Expenses"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    style="@style/TitleText"
                    android:textColor="@color/blue_700" />

                <TextView
                    android:id="@+id/tvExpenseTotal"
                    android:text="Rs. 0.00"
                    style="@style/TitleText"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:paddingTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Profit Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardProfit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/green_200">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:text="Net Profit"
                    style="@style/TitleText"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/green_700" />

                <TextView
                    android:id="@+id/tvProfit"
                    android:text="Rs. 0.00"
                    style="@style/TitleText"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:paddingTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
