<?xml version="1.0" encoding="utf-8"?>
    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/card_summary_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dp">

        <TextView
            android:id="@+id/tv_date_range_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Summary Period"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_date_range_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="@color/milk_on_surface"
            android:textSize="16sp"
            app:layout_constraintBaseline_toBaselineOf="@id/tv_date_range_label"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tv_date_range_label"
            tools:text="15 Aug 2024 - 30 Aug 2024" />

        <View
            android:id="@+id/separator_header"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="?attr/colorOutline"
            app:layout_constraintTop_toBottomOf="@id/tv_date_range_value" />

        <TextView
            android:id="@+id/tv_total_milk_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Total Volume (Ltr)"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/separator_header" />

        <TextView
            android:id="@+id/tv_total_milk_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/milk_on_surface"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBaseline_toBaselineOf="@id/tv_total_milk_label"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="450.50" />

        <TextView
            android:id="@+id/tv_total_ts_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Average TS"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_total_milk_label" />

        <TextView
            android:id="@+id/tv_avg_ts_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/milk_on_surface"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBaseline_toBaselineOf="@id/tv_total_ts_label"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="55.80" />

        <View
            android:id="@+id/separator_middle"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="?attr/colorOutline"
            app:layout_constraintTop_toBottomOf="@id/tv_total_ts_label" />

        <TextView
            android:id="@+id/tv_total_price_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Total Price"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/milk_on_surface"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/separator_middle" />

        <TextView
            android:id="@+id/tv_total_price_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintBaseline_toBaselineOf="@id/tv_total_price_label"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="₹ 45,500" />

        <TextView
            android:id="@+id/tv_payment_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Paid Amount"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_total_price_label" />

        <TextView
            android:id="@+id/tv_payment_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/milk_on_surface"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBaseline_toBaselineOf="@id/tv_payment_label"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="₹ 30,000" />

        <TextView
            android:id="@+id/tv_balance_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:text="Balance Due"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_payment_label" />

        <TextView
            android:id="@+id/tv_balance_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBaseline_toBaselineOf="@id/tv_balance_label"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="₹ 15,500" />

    </androidx.constraintlayout.widget.ConstraintLayout>

