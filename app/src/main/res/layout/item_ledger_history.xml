<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_8"
    android:paddingVertical="@dimen/space_12"
    android:weightSum="5">


    <TextView
        android:id="@+id/tvDate"
        android:textAppearance="@style/TextAppearance.MilkLedger.BodyMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="12 Oct" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvType"
            android:textAppearance="@style/TextAppearance.MilkLedger.BodyLarge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:gravity="start"
            android:textColor="?attr/colorOnSurface"
            tools:text="Milk Purchase" />

        <TextView
            android:id="@+id/tvDebit"
            android:textAppearance="@style/TextAppearance.MilkLedger.AmountSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start"
            android:textColor="?attr/colorLedgerExpense"
            tools:text="5000" />

        <TextView
            android:id="@+id/tvCredit"
            android:textAppearance="@style/TextAppearance.MilkLedger.AmountSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="?attr/colorLedgerIncome"
            tools:text="0" />


    </LinearLayout>


</LinearLayout>
