<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_card"
    android:backgroundTint="@color/orange_700"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp"
    android:weightSum="11">


    <TextView
        android:id="@+id/tvSort"
        style="@style/Text.Title"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"

        android:layout_weight="1"
        android:gravity="start"
        android:text="1"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSupplierName"
        style="@style/Text.Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="5"
        android:gravity="center"
        android:text="Ali Imran"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/tvSort"
        app:layout_constraintStart_toEndOf="@+id/tvSort"
        app:layout_constraintTop_toTopOf="@+id/tvSort" />

    <TextView
        android:id="@+id/tvSupplierRate"
        style="@style/Text.Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="4"
        android:gravity="end"
        android:text="Rs. 25.50"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/tvSort"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvSort" />


</androidx.constraintlayout.widget.ConstraintLayout>
