<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:backgroundTint="@color/orange_200"
    app:cardUseCompatPadding="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Row 1: Position + Name -->
        <TextView
            android:id="@+id/tvPosition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="1"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSupplierName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Ali Imran"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="@id/tvPosition"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvPosition"
            app:layout_constraintTop_toTopOf="@id/tvPosition" />

        <!-- Row 2: Rate + Advance -->
        <!-- Rate Label -->
        <TextView
            android:id="@+id/tvRateLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Rate:"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="@id/tvPosition"
            app:layout_constraintTop_toBottomOf="@id/tvPosition" />

        <!-- Rate Value -->
        <TextView
            android:id="@+id/tvSupplierRate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Rs. 25.50"
            android:textSize="16sp"
            app:layout_constraintBaseline_toBaselineOf="@id/tvRateLabel"
            app:layout_constraintStart_toEndOf="@id/tvRateLabel" />

        <!-- Advance Label -->
        <TextView
            android:id="@+id/tvAdvanceLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Advance:"
            android:textSize="16sp"
            app:layout_constraintBaseline_toBaselineOf="@id/tvRateLabel"
            app:layout_constraintEnd_toStartOf="@+id/tvAdvanceAmount" />

        <!-- Advance Value -->
        <TextView
            android:id="@+id/tvAdvanceAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2550"
            android:textSize="16sp"
            app:layout_constraintBaseline_toBaselineOf="@id/tvRateLabel"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
