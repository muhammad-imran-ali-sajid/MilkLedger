<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/SaleCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:backgroundTint="@color/grey"
            android:background="@drawable/bg_edittext_readable">

            <TextView
                android:id="@+id/tv_date"
                style="@style/TextLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:paddingStart="12dp"
                android:text="18 Oct 2025" />

            <TextView
                android:id="@+id/rateAlert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Rate Applied"
                android:textColor="@color/red"
                 />


        </LinearLayout>


        <!-- Row 1: Labels and Values -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">

            <!-- Volume -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    style="@style/TextLabel"
                    android:text="Volume" />

                <TextView
                    android:id="@+id/tvMilk"
                    style="@style/TextValue"
                    tools:text="40.0" />
            </LinearLayout>

            <!-- Deduction -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    style="@style/TextLabel"
                    android:text="Deduction" />

                <TextView
                    android:id="@+id/tv_deduction"
                    style="@style/TextValue"
                    tools:text="2.0" />
            </LinearLayout>

            <!-- Total -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    style="@style/TextLabel"
                    android:text="Net Milk" />

                <TextView
                    android:id="@+id/tvNetMilk"
                    style="@style/TextValue"
                    tools:text="38.0" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="8dp" />

        <!-- Row 2: Urdu Labels -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_edittext_readable"
            android:orientation="horizontal"
            android:paddingVertical="8dp"
            android:weightSum="4">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView style="@style/TextLabel" android:text="Price" />
                <TextView
                    android:id="@+id/tvPrice"
                    style="@style/TextValue"
                    tools:text="10000" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:gravity="center"
                android:orientation="vertical">

                <TextView style="@style/TextLabel"
                    android:text="Payment" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPayment"
                        style="@style/TextValue"
                        tools:text="10,000" />

                    <TextView
                        android:id="@+id/tvPaymentDate"
                        style="@style/TextValue"
                        android:paddingStart="4dp"
                        android:textSize="18sp"
                        android:text="(20/11)"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnBalance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    style="@style/TextLabel"
                    android:text="Bal." />

                <TextView
                    android:id="@+id/tvBalance"
                    style="@style/TextValue"
                    tools:text="10000" />
            </LinearLayout>
        </LinearLayout>

        <!-- Notes -->
        <TextView
            android:id="@+id/tvNotes"
            style="@style/TextValue"
            android:layout_marginStart="12dp"
            tools:text="Note: no note" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
