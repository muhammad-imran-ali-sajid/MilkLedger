<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_4"
    android:orientation="vertical"
    android:padding="@dimen/space_8"
    app:strokeColor="?attr/colorOutlineVariant">


    <TextView
        android:id="@+id/tvDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.MilkLedger.BodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="12/12" />


    <com.google.android.material.divider.MaterialDivider
        android:layout_width="65dp"
        android:layout_height="2dp"
        app:dividerColor="?attr/colorOutline" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:weightSum="3">


        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:textAppearance="@style/TextAppearance.MilkLedger.LabelMedium"
            android:textColor="?attr/colorOnSurface"
            tools:ignore="NestedWeights"
            tools:text="Sale Payment - Ali Store" />


        <TextView
            android:id="@+id/tvAmount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end|center_vertical"
            android:textAppearance="@style/TextAppearance.MilkLedger.AmountMedium"
            android:textColor="?attr/colorLedgerIncome"
            tools:text="+ 5,000" />


    </LinearLayout>

</LinearLayout>


