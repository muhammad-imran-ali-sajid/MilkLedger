<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#ddd"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:layout_marginTop="1dp"
    android:paddingEnd="16dp"
    android:weightSum="3"
    android:paddingBottom="8dp"
    android:gravity="center_vertical">

    <!-- 1. Supplier Name: Now has a fixed width of 160dp. -->
    <TextView
        android:id="@+id/tvLabel"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@android:color/black"

        tools:text="Ali Ahmed long name that gets clipped" />

    <!-- 2. Volume/Status: Fixed width of 80dp, centered text. -->
    <TextView
        android:id="@+id/tvVolume"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="@color/black"

        tools:text="15.5 kg" />

    <!-- 3. Paid Amount: Fixed width of 80dp, text aligned to the end (right). -->
    <TextView
        android:id="@+id/tvPaidAmount"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end"
        android:textColor="@color/black"

        android:textStyle="bold"
        tools:text="199.00" />

</LinearLayout>