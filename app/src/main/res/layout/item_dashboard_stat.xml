<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardRoot"
    style="@style/Widget.MilkLedger.MaterialCard.Standard"
    android:layout_width="match_parent"
    app:contentPadding="@dimen/space_16"
    android:layout_marginVertical="@dimen/space_4"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:textAppearance="@style/TextAppearance.MilkLedger.CardTitle"
            android:layout_width="match_parent"
            android:alpha="0.6"
            android:layout_height="wrap_content"
            tools:text="Milk Sales" />

        <TextView
            android:id="@+id/tvValue"
            android:textAppearance="@style/TextAppearance.MilkLedger.AmountMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="150 Ltr" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
