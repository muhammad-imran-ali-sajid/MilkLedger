<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".features.sale.customerhistory.CustomerHistoryFragment">

    <!-- ===================== -->
    <!-- Date Header Card -->
    <!-- ===================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/dateHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_selected_date"
            style="@style/TitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="22 Oct 2025"
            android:textSize="18sp"
            android:textColor="?attr/colorOnSurface" />
    </com.google.android.material.card.MaterialCardView>

    <!-- ===================== -->
    <!-- Empty State -->
    <!-- ===================== -->
    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No records for this date"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnBackground"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/dateHeader"
        app:layout_constraintBottom_toTopOf="@id/customer_summary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible" />

    <!-- ===================== -->
    <!-- Customer Detail List -->
    <!-- ===================== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCustomerDetail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="4dp"
        android:paddingBottom="90dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/dateHeader"
        app:layout_constraintBottom_toTopOf="@id/customer_summary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/RecyclerViewStyle"
        tools:listitem="@layout/item_customer_detail"
        tools:itemCount="6" />

    <!-- ===================== -->
    <!-- Customer Summary (Sticky Bottom Sheet) -->
    <!-- ===================== -->
    <com.miassolutions.milkledger.utils.customviews.CollapsibleCardView
        android:id="@+id/customer_summary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        android:background="?attr/colorSurface"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
