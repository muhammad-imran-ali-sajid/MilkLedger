<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/PurchaseCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="2"
            android:background="@drawable/bg_purchase"
            android:clickable="true"
            android:focusable="true"
            android:gravity="start"
            android:layoutDirection="ltr"
            android:orientation="horizontal"
            android:weightSum="8">

            <ImageButton
                android:id="@+id/btn_edit_form"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:backgroundTint="@color/transparent"
                android:src="@drawable/ic_edit_form"
                app:tint="@color/white"
                tools:ignore="NestedWeights" />


            <TextView
                android:id="@+id/tvName"
                style="@style/TextLabel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="4"
                android:text="Ali"
                android:textColor="@color/white" />


            <ImageButton
                android:id="@+id/btnSupplierHistory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:backgroundTint="@color/transparent"
                android:rotation="180"
                android:src="@drawable/ic_arrow"
                app:tint="@color/white" />
        </LinearLayout>


        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
                android:background="@drawable/bg_edittext_readable"
            android:orientation="horizontal"
            android:weightSum="4">


            <!-- Volume -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    style="@style/TextLabel"
                    android:text="Vol." />

                <TextView
                    android:id="@+id/tvVolume"
                    style="@style/TextValue"
                    tools:text="3.5" />
            </LinearLayout>

            <!-- Fat -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    style="@style/TextLabel"
                    android:text="Fat" />

                <TextView
                    android:id="@+id/tvFat"
                    style="@style/TextValue"

                    tools:text="4.5" />
            </LinearLayout>

            <!-- LR -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    style="@style/TextLabel"
                    android:text="LR" />

                <TextView
                    android:id="@+id/tvLr"
                    style="@style/TextValue"
                    tools:text="28.1" />
            </LinearLayout>

            <!-- TS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    style="@style/TextLabel"
                    android:text="TS" />

                <TextView
                    android:id="@+id/tvTs"
                    style="@style/TextValue"
                    tools:text="8.4" />
            </LinearLayout>
        </LinearLayout>

<!--        <com.google.android.material.divider.MaterialDivider-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="2dp" />-->

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_edittext_readable"
            android:orientation="horizontal"
            android:paddingVertical="8dp"
            android:weightSum="4">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView style="@style/TextLabel" android:text="Price" />
                <TextView
                    android:id="@+id/tvPrice"
                    style="@style/TextValue"
                    tools:text="10000" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:gravity="center"
                android:orientation="vertical">

                <TextView style="@style/TextLabel"
                    android:text="Payment" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPayment"
                        style="@style/TextValue"
                        tools:text="10,000" />

                    <TextView
                        android:id="@+id/tvPaymentDate"
                        style="@style/TextValue"
                        android:paddingStart="4dp"
                        android:textSize="18sp"
                        android:text="(20/11)"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnBalance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    style="@style/TextLabel"
                    android:text="Bal." />

                <TextView
                    android:id="@+id/tvBalance"
                    style="@style/TextValue"
                    tools:text="10000" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="3dp"
            app:dividerColor="#eee" />
        <!-- Notes Row -->
        <TextView
            android:id="@+id/tvNotes"
            style="@style/TextValue"
            android:layout_marginStart="12dp"
            tools:text="Note : no note" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
