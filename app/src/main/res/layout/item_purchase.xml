<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.MilkLedger.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:contentPadding="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorPurchase"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="2dp">

            <ImageButton
                android:id="@+id/btn_edit_form"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Edit"
                android:src="@drawable/ic_edit_form"
                app:tint="?attr/colorOnPrimary" />

            <TextView
                android:id="@+id/tvName"
                style="@style/Text.MilkLedger.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:text="Ali"
                android:textColor="?attr/colorOnPrimary" />

            <ImageButton
                android:id="@+id/btnSupplierHistory"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="History"
                android:rotation="180"
                android:src="@drawable/ic_arrow"
                app:tint="?attr/colorOnPrimary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:weightSum="5">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.5"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.MilkLedger.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vol." />

                    <TextView
                        android:id="@+id/tvVolume"
                        style="@style/Text.MilkLedger.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="3.5" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.MilkLedger.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fat" />

                    <TextView
                        android:id="@+id/tvFat"
                        style="@style/Text.MilkLedger.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="4.5" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.MilkLedger.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LR" />

                    <TextView
                        android:id="@+id/tvLr"
                        style="@style/Text.MilkLedger.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="28.1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.5"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.MilkLedger.Label"
                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"
                        android:text="TS" />

                    <TextView
                        android:id="@+id/tvTs"
                        style="@style/Text.MilkLedger.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="8.4" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="4dp"
                android:alpha="0.5"
                android:background="?attr/colorOutlineVariant" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.MilkLedger.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Price" />

                    <TextView
                        android:id="@+id/tvPrice"
                        style="@style/Text.MilkLedger.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="000,000" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tilPayment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.MilkLedger.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableEnd="@drawable/ic_info"
                        android:drawablePadding="6dp"
                        android:drawableTint="?attr/colorOnSecondaryContainer"
                        android:text="Paid" />

                    <TextView
                        android:id="@+id/tvPayment"
                        style="@style/Text.MilkLedger.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="000,000" />


                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnBalance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.MilkLedger.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableEnd="@drawable/ic_info"
                        android:drawablePadding="4dp"
                        android:drawableTint="?attr/colorOnSecondaryContainer"
                        android:text="Bal." />

                    <TextView
                        android:id="@+id/tvBalance"
                        style="@style/Text.MilkLedger.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:lines="1"
                        android:textColor="?attr/colorError"
                        app:autoSizeMaxTextSize="24sp"
                        app:autoSizeMinTextSize="14sp"
                        app:autoSizeTextType="uniform"
                        tools:text="000,000" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvNotes"
                style="@style/Text.MilkLedger.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:alpha="0.8"
                android:textStyle="italic"
                tools:text="Note: Milk was slightly thin." />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>