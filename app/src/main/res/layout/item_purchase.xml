<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"

    style="@style/PurchaseCard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Name -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@drawable/bg_edittext_readable"
            android:layout_marginBottom="8dp"
            android:layout_weight="2"
            android:gravity="start"
            android:clickable="true"
            android:focusable="true"
            android:layoutDirection="ltr"
            android:weightSum="8"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_edit_form"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/transparent"
                android:src="@drawable/ic_edit_form"
                tools:ignore="NestedWeights" />



            <TextView
                android:id="@+id/tvName"
                style="@style/TextTitleUrdu"
                android:layout_weight="4"
                android:text="Ali"
                android:layout_width="0dp" />


            <ImageButton
                android:id="@+id/btn_supplier_detail"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/transparent"
                android:rotation="180"
                android:src="@drawable/ic_arrow" />
        </LinearLayout>


        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal"
            android:weightSum="4">


            <!-- Volume -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    style="@style/TextLabel"
                    android:text="Milk" />

                <TextView
                    android:id="@+id/tvVolume"
                    style="@style/TextValue"
                    tools:text="3.5" />
            </LinearLayout>

            <!-- Fat -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    style="@style/TextLabel"
                    android:text="Fat" />

                <TextView
                    android:id="@+id/tvFat"
                    style="@style/TextValue"

                    tools:text="4.5" />
            </LinearLayout>

            <!-- LR -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    style="@style/TextLabel"
                    android:text="LR" />

                <TextView
                    android:id="@+id/tvLr"
                    style="@style/TextValue"
                    tools:text="28.1" />
            </LinearLayout>

            <!-- TS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    style="@style/TextLabel"
                    android:text="TS" />

                <TextView
                    android:id="@+id/tvTs"
                    style="@style/TextValue"
                    tools:text="8.4" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">

            <!-- Price -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    style="@style/TextLabel"
                    android:text="Price" />

                <TextView
                    android:id="@+id/tvPrice"
                    style="@style/TextValue"
                    android:text="10000" />
            </LinearLayout>

            <!-- Paid -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    style="@style/TextLabel"
                    android:text="Payment" />

                <TextView
                    android:id="@+id/tvPaid"
                    style="@style/TextValue"
                    android:text="10000"
                    android:textColor="@color/success" />
            </LinearLayout>

            <!-- Balance -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    style="@style/TextLabel"
                    android:text="Balance" />

                <TextView
                    android:id="@+id/tvBalance"
                    style="@style/TextValue"
                    android:text="10000"

                    android:textDirection="ltr" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="3dp"
            app:dividerColor="#eee" />
        <!-- Notes Row -->
        <TextView
            android:id="@+id/tvNotes"
            style="@style/TextValue"
            android:layout_marginStart="12dp"
            tools:text="Note : no note" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
