<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    android:backgroundTint="@android:color/white"
    android:layoutDirection="rtl"
    android:textDirection="rtl"
    app:cardCornerRadius="16dp"
    app:cardElevation="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Supplier Name -->
        <TextView
            android:id="@+id/tv_supplier_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Supplier Name"
            android:textColor="#111111"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Grid for Volume, Fat, LR, TS -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alignmentMode="alignMargins"
            android:columnCount="4"
            android:useDefaultMargins="true">

            <!-- Volume -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Vol (L)"
                    android:textColor="#333"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_volume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_edittext_readable"
                    android:gravity="center"
                    android:imeOptions="actionNext"
                    android:inputType="numberDecimal"
                    android:layoutDirection="ltr"
                    android:nextFocusForward="@id/et_fat"
                    android:paddingVertical="6dp"
                    android:textDirection="ltr"
                    android:textSize="17sp" />
            </LinearLayout>

            <!-- Fat -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Fat (%)"
                    android:textColor="#333"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_fat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_edittext_readable"
                    android:gravity="center"
                    android:imeOptions="actionNext"
                    android:nextFocusForward="@id/et_lr"
                    android:inputType="numberDecimal"
                    android:paddingVertical="6dp"
                    android:textDirection="ltr"
                    android:textSize="17sp" />
            </LinearLayout>

            <!-- LR -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="LR"
                    android:textColor="#333"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_lr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_edittext_readable"
                    android:gravity="center"
                    android:imeOptions="actionNext"
                    android:nextFocusDown="@id/et_paid"
                    android:inputType="numberDecimal"
                    android:paddingVertical="6dp"
                    android:textDirection="ltr"
                    android:textSize="17sp" />
            </LinearLayout>

            <!-- TS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:gravity="center"

                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TS"
                    android:textColor="#333"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_ts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:text="0.00"
                    android:textColor="#111111"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </GridLayout>


        <!-- Single Row: Price, Paid (EditText), and Balance -->
        <!-- Titles on Top, Values Below for Price, Paid, and Balance -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:weightSum="3">

            <!-- Price -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Amount"
                    android:textColor="#333"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_price"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_edittext_readable"
                    android:backgroundTint="@color/sale_color"
                    android:gravity="center"
                    android:paddingVertical="6dp"
                    android:text="Rs, 0.00"
                    android:textColor="#fff"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Paid -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Paid"
                    android:textColor="#333"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_paid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_edittext_readable"
                    android:backgroundTint="@color/info"
                    android:textColor="#fff"
                    android:textStyle="bold"
                    android:nextFocusDown="@id/et_notes"
                    android:gravity="center"
                    android:inputType="numberDecimal"
                    android:paddingVertical="6dp"
                    android:textDirection="ltr"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Balance -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Balance"
                    android:textColor="#333"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_balance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_edittext_readable"
                    android:backgroundTint="#D32F2F"
                    android:gravity="center"
                    android:paddingVertical="6dp"
                    android:text="Rs. 0.00"
                    android:textColor="#fff"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>


        <!-- Notes -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:text="Notes"
            android:textColor="#666"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_edittext_readable"
            android:inputType="textCapSentences"
            android:paddingVertical="6dp"
            android:imeOptions="actionDone"
            android:paddingStart="10dp"
            android:textSize="17sp"
            tools:ignore="RtlSymmetry" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
