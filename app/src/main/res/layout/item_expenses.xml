<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.MilkLedger.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginTop="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="5">

            <!-- Icon -->
            <FrameLayout
                android:id="@+id/layoutIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_circle_light_gray"
                android:backgroundTint="@color/orange_700">

                <TextView
                    android:id="@+id/tvInitial"
                    style="@style/Text.Normal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    tools:text="A" />
            </FrameLayout>

            <!-- Title -->
            <TextView
                android:id="@+id/tvExpenseTitle"
                style="@style/Text.Expense"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:layout_weight="3"
                android:text="Fuel"
                android:textStyle="bold" />

            <!-- Amount -->
            <TextView
                android:id="@+id/tvExpenseAmount"
                style="@style/Text.Expense"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="8dp"
                android:layout_weight="2"
                android:gravity="end"
                android:text="Rs. 25.50" />

        </LinearLayout>

        <!-- Divider -->
        <com.google.android.material.divider.MaterialDivider
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="6dp" />

        <!-- Note -->
        <TextView
            android:id="@+id/tvExpenseNote"
            style="@style/TextValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:text="Note: My Note" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
