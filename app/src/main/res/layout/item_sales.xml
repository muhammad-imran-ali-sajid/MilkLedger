<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:layout_marginHorizontal="8dp"
    android:layoutDirection="rtl"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Customer Name -->
        <TextView
            android:id="@+id/tv_customer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ظفر عباس"
            android:paddingStart="16dp"
            android:layout_marginBottom="8dp"
            style="@style/TextTitleUrdu" />

        <!-- Row 1: Labels and Values -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="8dp"
            android:weightSum="3">

            <!-- Volume -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:text="Milk"
                    style="@style/TextLabel" />

                <TextView
                    android:id="@+id/tvMilk"
                    tools:text="40.0"
                    style="@style/TextValue" />
            </LinearLayout>

            <!-- Deduction -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:text="Deduction"
                    style="@style/TextLabel" />

                <TextView
                    android:id="@+id/tv_deduction"
                    tools:text="2.0"
                    style="@style/TextValue" />
            </LinearLayout>

            <!-- Total -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:text="Net Milk"
                    style="@style/TextLabel" />

                <TextView
                    android:id="@+id/tvNetMilk"
                    tools:text="38.0"
                    style="@style/TextValue" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: Urdu Labels -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="8dp"
            android:weightSum="3">

            <!-- Price -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:text="قیمت"
                    style="@style/TextTitleUrdu" />

                <TextView
                    android:id="@+id/tvPrice"
                    android:text="10000"
                    style="@style/TextValue" />
            </LinearLayout>

            <!-- Payment -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:text="ادائیگی"
                    style="@style/TextTitleUrdu" />

                <TextView
                    android:id="@+id/tvPayment"
                    android:text="10000"
                    style="@style/TextValue" />
            </LinearLayout>

            <!-- Balance -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:text="بیلنس"
                    style="@style/TextTitleUrdu" />

                <TextView
                    android:id="@+id/tvBalance"
                    android:text="10000"
                    android:textDirection="ltr"
                    style="@style/TextValue" />
            </LinearLayout>
        </LinearLayout>

        <!-- Notes -->
        <TextView
            android:id="@+id/tvNotes"
            tools:text="نوٹ: کوئی بات نہیں لکھی گئی"
            style="@style/TextTitleUrdu" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
