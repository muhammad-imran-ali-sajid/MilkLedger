<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/SaleCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"

    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="2"
            android:background="@drawable/bg_sale"
            android:clickable="true"
            android:focusable="true"
            android:gravity="start"
            android:layoutDirection="ltr"
            android:orientation="horizontal"
            android:weightSum="8">

            <ImageButton
                android:id="@+id/btn_edit_form"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:backgroundTint="@color/transparent"
                android:src="@drawable/ic_edit_form"
                app:tint="@color/white"
                tools:ignore="NestedWeights" />


            <TextView
                android:id="@+id/tvName"
                style="@style/TextLabel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="4"
                android:text="Ali"
                android:textColor="@color/white" />


            <ImageButton
                android:id="@+id/btn_customer_detail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:backgroundTint="@color/transparent"
                android:rotation="180"
                android:src="@drawable/ic_arrow"
                app:tint="@color/white" />
        </LinearLayout>

        <!-- Row 1: Labels and Values -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_edittext_readable"
            android:weightSum="3">

            <!-- Volume -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    style="@style/TextLabel"
                    android:text="Volume" />

                <TextView
                    android:id="@+id/tvMilk"
                    style="@style/TextValue"
                    tools:text="40.0" />
            </LinearLayout>

            <!-- Deduction -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    style="@style/TextLabel"
                    android:text="Deduction" />

                <TextView
                    android:id="@+id/tv_deduction"
                    style="@style/TextValue"
                    tools:text="2.0" />
            </LinearLayout>

            <!-- Total -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    style="@style/TextLabel"
                    android:text="Net Milk" />

                <TextView
                    android:id="@+id/tvNetMilk"
                    style="@style/TextValue"
                    tools:text="38.0" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_marginVertical="4dp"
            android:layout_height="1dp" />
        <!-- Row 2: Urdu Labels -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="8dp"
            android:backgroundTint="@color/blue_100"
            android:background="@drawable/bg_edittext_readable"
            android:weightSum="4">

            <!-- Price -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    style="@style/TextLabel"
                    android:text="Price" />

                <TextView
                    android:id="@+id/tvPrice"
                    style="@style/TextValue"
                    android:text="10000" />
            </LinearLayout>

            <!-- Payment -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:orientation="vertical"
                android:gravity="center"
                >

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Received"
                    android:textColor="@color/black"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:gravity="center"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingTop="4dp">

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:id="@+id/tvPayment"
                        android:text="10,000"
                        android:textColor="@color/black"
                        android:textAppearance="?attr/textAppearanceTitleSmall"/>

                    <TextView
                        android:textColor="@color/black"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:id="@+id/tvReceiveDate"
                        android:text="(20/11)"
                        android:visibility="gone"
                        android:paddingStart="4dp"
                        android:textAppearance="?attr/textAppearanceBodySmall"/>
                </LinearLayout>

            </LinearLayout>



            <!-- Balance -->
            <LinearLayout
                android:id="@+id/btnBalance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    style="@style/TextLabel"
                    android:text="Balance" />

                <TextView
                    android:id="@+id/tvBalance"
                    style="@style/TextValue"
                    android:text="10000"
                    android:textDirection="ltr" />
            </LinearLayout>
        </LinearLayout>

        <!-- Notes -->
        <TextView
            android:id="@+id/tvNotes"
            style="@style/TextValue"
            android:layout_marginStart="12dp"
            tools:text="Note: no note" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
