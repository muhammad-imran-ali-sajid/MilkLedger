<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.miassolutions.milkledger.utils.customviews.DateFilterView
        android:id="@+id/dateFilterView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dateFilterView">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNote"
                    style="@style/Widget.MilkLedger.Button.Icon"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="My Notes"
                    app:icon="@android:drawable/ic_menu_edit"
                    app:iconGravity="top"
                    app:iconPadding="8dp" />


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCashFlow"
                    style="@style/Widget.MilkLedger.Button.Icon"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Cash Flow"
                    app:icon="@drawable/ic_cashflow"
                    app:iconGravity="top"
                    app:iconPadding="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWallet"
                    style="@style/Widget.MilkLedger.Button.Icon"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="My Wallet"
                    app:icon="@drawable/ic_wallet_1"
                    app:iconGravity="top"
                    app:iconPadding="8dp" />


            </LinearLayout>


            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">


                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnPurchase"
                        style="@style/Widget.MilkLedger.DashboardCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true">


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/Text.MilkLedger.DashboardLabel"

                                android:text="Purchases" />

                            <TextView
                                android:id="@+id/tvTotalPurchases"
                                android:drawableEnd="@drawable/ic_arrow_right"
                                style="@style/Text.MilkLedger.DashboardValue"
                                android:textColor="?attr/purchaseColor"
                                tools:text="7,500,000" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnSale"
                        style="@style/Widget.MilkLedger.DashboardCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/Text.MilkLedger.DashboardLabel"
                                android:text="Sales" />

                            <TextView
                                android:id="@+id/tvTotalSales"
                                android:drawableEnd="@drawable/ic_arrow_right"
                                style="@style/Text.MilkLedger.DashboardValue"
                                android:textColor="?attr/saleColor"
                                tools:text="12,000" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnExpense"
                        style="@style/Widget.MilkLedger.DashboardCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/Text.MilkLedger.DashboardLabel"
                                android:text="Expenses" />

                            <TextView
                                android:id="@+id/tvTotalExpense"
                                android:drawableEnd="@drawable/ic_arrow_right"
                                style="@style/Text.MilkLedger.DashboardValue"
                                android:textColor="?attr/colorError"
                                tools:text="4,500" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.MilkLedger.DashboardCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/Text.MilkLedger.DashboardLabel"
                                android:text="Gross Profit"
                                android:textColor="?attr/colorOnPrimaryContainer" />

                            <TextView
                                android:id="@+id/tvNetProfit"
                                style="@style/Text.MilkLedger.DashboardValue"
                                android:textColor="?attr/profitColor"
                                tools:text="4,500" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>


                    <TextView
                        style="@style/Text.MilkLedger.SectionHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Milk Overview" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvMilkStats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/item_dashboard_stat" />

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>


        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>