<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.miassolutions.milkledger.utils.customview.DateFilterView
        android:id="@+id/dateFilterView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dateFilterView">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingTop="8dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAccount"
                        style="@style/Widget.MilkLedger.Button.Icon"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="Accounts"
                        app:iconPadding="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCashFlow"
                        style="@style/Widget.MilkLedger.Button.Icon"
                        android:layout_weight="1"
                        android:text="Cash Flow"
                        app:iconGravity="top"
                        app:iconPadding="8dp" />
                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWallet"
                        style="@style/Widget.MilkLedger.Button.Icon"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="My Wallet"
                        app:iconGravity="top"
                        app:iconPadding="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNote"
                        style="@style/Widget.MilkLedger.Button.Icon"
                        android:layout_weight="1"
                        android:text="My Notes"
                        app:iconGravity="top"
                        app:iconPadding="8dp" />

                </LinearLayout>


            </LinearLayout>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="200dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginVertical="8dp"
                app:dividerColor="?attr/colorSurfaceVariant"
                android:layout_height="2dp" />

            <TextView
                android:textAppearance="@style/TextAppearance.MilkLedger.SectionTitle"
                android:textColor="?attr/colorOnSurface"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.7"
                android:layout_marginBottom="12dp"
                android:text="Money Overview" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:weightSum="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnPurchase"
                        style="@style/Widget.MilkLedger.DashboardCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="?attr/colorPurchase">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Text.MilkLedger.DashboardLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:drawableEnd="@drawable/ic_arrow_forward"
                                android:drawableTint="?attr/colorOnPrimary"
                                android:text="Purchases"
                                android:textColor="?attr/colorOnPrimary" />

                            <TextView
                                android:id="@+id/tvTotalPurchases"
                                style="@style/Text.MilkLedger.DashboardValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="?attr/colorOnPrimary"
                                tools:text="7.5 M" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnExpense"
                        style="@style/Widget.MilkLedger.DashboardCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="?attr/colorExpense"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Text.MilkLedger.DashboardLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:drawableEnd="@drawable/ic_arrow_forward"
                                android:drawableTint="?attr/colorOnPrimary"
                                android:text="Expenses"
                                android:textColor="?attr/colorOnPrimary" />

                            <TextView
                                android:id="@+id/tvTotalExpense"
                                style="@style/Text.MilkLedger.DashboardValue"
                                android:layout_width="wrap_content"

                                android:layout_height="wrap_content"
                                android:textColor="?attr/colorOnPrimary"
                                tools:text="4,500" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardPersonalExpense"
                        app:cardBackgroundColor="?attr/colorErrorContainer"
                        style="@style/Widget.MilkLedger.DashboardCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        >

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Text.MilkLedger.DashboardLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:text="Prsnl Exp." />

                            <TextView
                                android:id="@+id/tvPersonalExpense"
                                style="@style/Text.MilkLedger.DashboardValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="?attr/colorExpense"
                                tools:text="3,500" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnSale"
                        style="@style/Widget.MilkLedger.DashboardCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="?attr/colorSale">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Text.MilkLedger.DashboardLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:drawableEnd="@drawable/ic_arrow_forward"
                                android:drawableTint="?attr/colorOnPrimary"
                                android:text="Sales"
                                android:textColor="?attr/colorOnPrimary" />

                            <TextView
                                android:id="@+id/tvTotalSales"
                                style="@style/Text.MilkLedger.DashboardValue"
                                android:layout_width="wrap_content"

                                android:layout_height="wrap_content"
                                android:textColor="?attr/colorOnPrimary"
                                tools:text="12K" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardProfit"
                        app:cardBackgroundColor="?attr/colorSecondaryContainer"
                        style="@style/Widget.MilkLedger.DashboardCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Text.MilkLedger.DashboardLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:text="Net Profit" />

                            <TextView
                                android:id="@+id/tvNetProfit"
                                style="@style/Text.MilkLedger.DashboardValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="?attr/colorProfit"
                                tools:text="55K" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardRemaining"
                        style="@style/Widget.MilkLedger.DashboardCard"
                        android:layout_width="match_parent"
                        app:cardBackgroundColor="?attr/colorPrimaryContainer"
                        android:layout_height="wrap_content"
                        >

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Text.MilkLedger.DashboardLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:text="My Profit" />

                            <TextView
                                android:id="@+id/tvRemainingBalance"
                                style="@style/Text.MilkLedger.DashboardValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="?attr/colorPrimary"
                                tools:text="51.5K" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </LinearLayout>


            <com.google.android.material.divider.MaterialDivider
                android:layout_width="200dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginVertical="8dp"
                app:dividerColor="?attr/colorSurfaceVariant"
                android:layout_height="2dp" />

            <TextView
                android:textAppearance="@style/TextAppearance.MilkLedger.SectionTitle"
                android:textColor="?attr/colorOnSurface"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.7"
                android:layout_marginBottom="12dp"
                android:text="Milk Overview" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMilkStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_dashboard_stat" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
