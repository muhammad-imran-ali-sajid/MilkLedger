<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">


    <TextView
        android:id="@+id/tvTrial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="10dp"
        android:gravity="center"
        android:rotation="-45"
        android:text="Trial Version Expired"
        android:textColor="#ff0000"
        android:textSize="40sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <include
        android:id="@+id/dateFilterLayout"
        layout="@layout/date_filter_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dateFilterLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dateFilterLayout">


            <LinearLayout
                android:id="@+id/cardGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.button.MaterialButton
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/teal_dark"
                        android:layout_height="wrap_content"
                        android:text="My Notes"
                        android:id="@+id/btnNote"/>

                    <com.google.android.material.button.MaterialButton
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/teal_dark"
                        android:layout_height="wrap_content"
                        android:text="Cash Flow"
                        android:id="@+id/btnCashFlow"/>

                </LinearLayout>

<!--                <com.google.android.material.card.MaterialCardView-->
<!--                    android:id="@+id/card_personal_expense"-->
<!--                    style="@style/DashboardCard"-->
<!--                    app:cardBackgroundColor="@color/orange_700">-->

<!--                    <LinearLayout-->
<!--                        style="@style/DashboardInnerRow"-->
<!--                        android:background="@drawable/bg_expense">-->

<!--                        <TextView-->
<!--                            android:gravity="center"-->
<!--                            style="@style/DashboardLabel"-->
<!--                            android:text="My Profile" />-->

<!--                        <TextView-->
<!--                            android:id="@+id/tvPersonalExpense"-->
<!--                            style="@style/DashboardValue"-->
<!--                            android:text="4,500"-->
<!--                            android:visibility="gone" />-->
<!--                    </LinearLayout>-->
<!--                </com.google.android.material.card.MaterialCardView>-->

<!--                <com.google.android.material.card.MaterialCardView-->
<!--                    android:id="@+id/cash_flow_card"-->
<!--                    style="@style/DashboardCard"-->
<!--                    app:cardBackgroundColor="@color/midnight_blue">-->

<!--                    <LinearLayout-->
<!--                        style="@style/DashboardInnerRow"-->
<!--                        android:background="@drawable/bg_expense">-->

<!--                        <TextView-->
<!--                            android:layout_width="match_parent"-->
<!--                            style="@style/DashboardValue"-->
<!--                            android:gravity="center"-->
<!--                            android:text="Cash Flow"-->
<!--                            android:textColor="@color/white" />-->
<!--                    </LinearLayout>-->



<!--                </com.google.android.material.card.MaterialCardView>-->


                <!-- Purchases -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/purchase_card"
                    style="@style/DashboardCard"
                    android:layout_width="match_parent">


                    <LinearLayout
                        style="@style/DashboardInnerRow"
                        android:background="@drawable/bg_purchase">

                        <TextView
                            style="@style/DashboardLabel"
                            android:text="Purchases" />

                        <TextView
                            android:id="@+id/tvTotalPurchases"
                            style="@style/DashboardValue"
                            android:text="7,500" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Sales -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/sale_card"
                    style="@style/DashboardCard"
                    android:layout_width="match_parent"
                    app:cardBackgroundColor="@color/sale_color">

                    <LinearLayout
                        style="@style/DashboardInnerRow"
                        android:background="@drawable/bg_sale">

                        <TextView
                            style="@style/DashboardLabel"
                            android:text="Sales" />

                        <TextView
                            android:id="@+id/tvTotalSales"
                            style="@style/DashboardValue"
                            android:text="12,000" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>


                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/expense_card"
                    style="@style/DashboardCard"
                    app:cardBackgroundColor="@color/red">

                    <LinearLayout
                        style="@style/DashboardInnerRow"
                        android:background="@drawable/bg_expense">

                        <TextView
                            style="@style/DashboardLabel"
                            android:text="Expenses" />

                        <TextView
                            android:id="@+id/tvTotalExpense"
                            style="@style/DashboardValue"
                            android:text="4,500" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>


                <!-- Profit -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardProfit"
                    style="@style/DashboardCard"
                    app:cardBackgroundColor="@color/deep_forest_green">

                    <LinearLayout
                        style="@style/DashboardInnerRow"
                        android:background="@drawable/bg_profit">

                        <TextView
                            style="@style/DashboardLabel"
                            android:text="Gross Profit" />

                        <TextView
                            android:id="@+id/tv_net_profit"
                            style="@style/DashboardValue"
                            android:text="4,500" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>



                <!-- Remaining Profit -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/DashboardCard"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/blue_700">

                    <LinearLayout style="@style/DashboardInnerRow">

                        <TextView
                            style="@style/DashboardLabel"
                            android:text="Net Profit" />

                        <TextView
                            android:id="@+id/tvRemainingProfit"
                            style="@style/DashboardValue"
                            android:text="4,500" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingHorizontal="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"

                    android:padding="12dp"
                    android:text="Milk Overview"
                    android:textColor="@color/black"
                    android:textSize="22sp" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginBottom="12dp"

                    android:orientation="vertical">

                    <!-- Milk Purchased -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/DashboardCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Purchased"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/tv_milk_purchase"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:text="Rs. 7,500"
                                android:textSize="20sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Milk Sold -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/DashboardCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Sold"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/tv_milk_sold"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:text="Rs. 8,200"
                                android:textSize="20sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>


                    <com.google.android.material.card.MaterialCardView
                        style="@style/DashboardCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Qty Diff"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/tvQtyDiff"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:text="Rs. 8,200"
                                android:textSize="20sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/DashboardCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        >

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Avg S.P."
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/tvAvgSP"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:text="180.0"
                                android:textSize="20sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/DashboardCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Avg P.P."
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/tvAvgCP"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:text="160.0"
                                android:textSize="20sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/DashboardCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Avg Price Diff"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/tvAvgPriceDiff"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:text="20.0"
                                android:textSize="20sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Avg Fat -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/DashboardCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        >

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Avg Fat"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/tv_avg_fat"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:text="4.2"
                                android:textSize="20sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Avg LR -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/DashboardCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Avg LR"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/tv_avg_lr"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:text="28.5"
                                android:textSize="20sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Total TS -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/DashboardCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Total TS"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/tv_total_ts"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:text="12.3"
                                android:textSize="20sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>


            </LinearLayout>


        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>
