<?xml version="1.0" encoding="utf-8"?>
<!-- Layout for the settings fragment where the user selects a background color. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@android:color/white">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose Application Background Color"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="16dp"
        android:textColor="@android:color/black" />

    <Button
        android:id="@+id/btn_color_blue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ocean Blue"
        android:layout_marginBottom="8dp"
        android:backgroundTint="#2196F3"
        android:textColor="@android:color/white" />

    <Button
        android:id="@+id/btn_color_green"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Forest Green"
        android:layout_marginBottom="8dp"
        android:backgroundTint="#4CAF50"
        android:textColor="@android:color/white" />

    <Button
        android:id="@+id/btn_color_gray"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Default Gray"
        android:backgroundTint="#9E9E9E"
        android:textColor="@android:color/white" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Color is saved automatically."
        android:textSize="14sp"
        android:textColor="#555555" />

</LinearLayout>