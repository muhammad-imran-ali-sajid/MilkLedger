<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_edittext_readable"
    android:paddingHorizontal="16dp"
    android:paddingTop="8dp">

    <!-- Metric 1: Total Milk (Label and Value Inline) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"

        android:paddingVertical="8dp">

        <TextView
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total Milk" />

        <TextView
            android:id="@+id/tv_total_milk"
            style="@style/Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="124.5 L" />
    </LinearLayout>

    <!-- Metric 2: Deduction (Label and Value Inline) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="8dp">

        <TextView
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Deduction" />

        <TextView
            android:id="@+id/tv_deduction"
            style="@style/Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="28.1" />
    </LinearLayout>

    <!-- Metric 3: Net Milk (Label and Value Inline) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="8dp">

        <TextView
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Net Milk" />

        <TextView
            android:id="@+id/tv_total_net_milk"
            style="@style/Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="4.3 L" />
    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp"
        app:dividerColor="#E0E0E0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
android:paddingHorizontal="4dp"

        android:background="@color/blue_100"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="8dp"

        android:paddingBottom="8dp">

        <TextView
            style="@style/Text.Title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"

            android:maxLines="1"
            android:text="Today Received" />

        <TextView
            android:id="@+id/tvReceivedAmount"
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:gravity="end"
            tools:text="Rs 101" />
    </LinearLayout>

    <!-- Metric 4: Total Amount (Label and Value Inline) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="8dp">

        <TextView
            style="@style/Text.Title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Total Amount" />

        <TextView
            android:id="@+id/tv_total_amount"
            style="@style/Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="Rs. 10500" />
    </LinearLayout>

    <!-- Metric 5: Avg Amount (Label and Value Inline) -->


    <!-- Metric 5: Avg Amount (Label and Value Inline) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="8dp"
        android:paddingBottom="8dp">

        <TextView
            style="@style/Text.Title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Avg Rate" />

        <TextView
            android:id="@+id/tv_avg_price"
            style="@style/Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="Rs. 84.3" />
    </LinearLayout>

</LinearLayout>