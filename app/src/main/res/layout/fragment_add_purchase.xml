<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"

    >

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_date"
        style="@style/MaterialButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="0dp"
        android:layout_marginTop="8dp"
        android:text="03 Dec 2025" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_supplier_name"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:hint="Supplier Name">

                <AutoCompleteTextView
                    android:id="@+id/actv_supplier_name"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:drawablePadding="8dp"
                    android:focusable="false"
                    android:inputType="none"
                    tools:ignore="LabelFor" />
            </com.google.android.material.textfield.TextInputLayout>


            <LinearLayout
                android:id="@+id/tilAdvance"
                style="@style/Style.InputRow"
                android:layout_marginTop="8dp">

                <TextView
                    style="@style/Style.InputLabel"
                    android:text="Advance" />

                <TextView
                    android:id="@+id/tvAdvanceAmount"
                    style="@style/Style.TextViewValue"
                    android:inputType="numberDecimal" />
            </LinearLayout>

            <LinearLayout
                style="@style/Style.InputRow"
                android:layout_marginTop="8dp">

                <TextView
                    style="@style/Style.InputLabel"
                    android:text="Volume" />

                <EditText
                    android:id="@+id/et_volume"
                    style="@style/Style.EditTextInput"
                    android:inputType="numberDecimal" />
            </LinearLayout>

            <LinearLayout
                style="@style/Style.InputRow"
                android:layout_marginTop="8dp">

                <TextView
                    style="@style/Style.InputLabel"
                    android:text="FAT" />

                <EditText
                    android:id="@+id/et_fat"
                    style="@style/Style.EditTextInput"
                    android:inputType="numberDecimal" />
            </LinearLayout>

            <LinearLayout
                style="@style/Style.InputRow"
                android:layout_marginTop="8dp">

                <TextView
                    style="@style/Style.InputLabel"
                    android:text="LR" />

                <EditText
                    android:id="@+id/et_lr"
                    style="@style/Style.EditTextInput"
                    android:inputType="numberDecimal" />
            </LinearLayout>

            <LinearLayout
                style="@style/Style.InputRow"
                android:layout_marginTop="8dp">

                <TextView
                    style="@style/Style.InputLabel"
                    android:text="TS" />

                <TextView
                    android:id="@+id/tv_ts"
                    style="@style/Style.TextViewValue.ReadOnly"
                    android:inputType="numberDecimal" />
            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/textView"
                    style="@style/Style.InputLabel"
                    android:layout_width="0dp"
                    android:text="Price"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="0.309" />

                <TextView
                    android:id="@+id/tv_price"
                    style="@style/Style.TextViewValue"
                    android:layout_width="0dp"
                    android:layout_marginStart="10dp"
                    android:paddingEnd="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/textView"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="0.3" />

                <TextView
                    android:id="@+id/tv_rate_header"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Rate"
                    android:textColor="@color/black"
                    android:textSize="10sp"
                    app:layout_constraintBottom_toTopOf="@+id/tv_rate"
                    app:layout_constraintEnd_toEndOf="@+id/tv_rate"
                    app:layout_constraintStart_toStartOf="@+id/tv_rate"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_rate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingStart="4dp"
                    android:text="000"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tv_price"
                    app:layout_constraintTop_toBottomOf="@id/tv_rate_header"
                    app:layout_constraintWidth_percent="0.3" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                style="@style/Style.InputRow"
                android:layout_marginTop="8dp">

                <TextView
                    style="@style/Style.InputLabel"
                    android:text="Paid" />

                <EditText
                    android:id="@+id/et_paid"
                    style="@style/Style.EditTextInput"
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal" />
            </LinearLayout>

            <LinearLayout
                style="@style/Style.InputRow"
                android:layout_marginTop="8dp">

                <TextView
                    style="@style/Style.InputLabel"
                    android:text="Balance" />

                <TextView
                    android:id="@+id/tv_balance"
                    style="@style/Style.TextViewValue.ReadOnly"
                    android:inputType="numberDecimal" />
            </LinearLayout>

            <LinearLayout
                style="@style/Style.InputRow"
                android:layout_marginTop="8dp"
                android:gravity="top">

                <TextView
                    style="@style/Style.InputLabel"
                    android:paddingTop="8dp"
                    android:text="Notes" />

                <EditText
                    android:id="@+id/et_notes"
                    style="@style/Style.EditTextInput"
                    android:imeOptions="actionDone"
                    android:inputType="textCapSentences" />
            </LinearLayout>


        </LinearLayout>

    </ScrollView>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:gravity="center"
        android:orientation="horizontal"

        android:weightSum="2">



        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            style="@style/MaterialButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:text="OK" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_saveNew"
            style="@style/MaterialButtonStyle"
            android:layout_width="0dp"

            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="OK &amp; New" />

    </LinearLayout>


</LinearLayout>

