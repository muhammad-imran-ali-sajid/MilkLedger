<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
  Base Theme: Theme.Material3.DayNight.NoActionBar
  This theme handles the switch between Light and Dark mode automatically
  and removes the default ActionBar, favoring a custom Material Top App Bar.
-->
    <style name="Theme.MilkLedger" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- ************************************ -->
        <!-- 1. COLOR ROLES (Light Theme Defaults)  -->
        <!-- ************************************ -->

        <!-- Brand Colors -->
        <item name="colorPrimary">@color/milk_primary</item>
        <item name="colorOnPrimary">@color/milk_on_primary</item>
        <item name="colorSecondary">@color/milk_secondary</item>
        <item name="colorOnSecondary">@color/milk_on_secondary</item>

        <!-- Surface Colors - NOW USING SIMPLIFIED NAMES -->
        <item name="colorSurface">@color/milk_surface</item>
        <item name="android:colorBackground">@color/milk_background</item>
        <item name="colorOnSurface">@color/milk_on_surface</item>

        <!-- Status Bar Color (Use primary color for brand consistency) -->
        <item name="android:statusBarColor">?attr/colorPrimary</item>

        <!-- ************************************ -->
        <!-- 2. TYPOGRAPHY (CRITICAL FOR READABILITY) -->
        <!-- ************************************ -->

        <!-- Customize key text styles to increase font size significantly -->

        <!-- For main body text in lists, cards, and paragraphs -->
        <item name="textAppearanceBodyLarge">@style/TextAppearance.MilkLedger.BodyLarge</item>

        <!-- For titles of large sections or cards -->
        <item name="textAppearanceTitleLarge">@style/TextAppearance.MilkLedger.TitleLarge</item>

        <!-- For screen titles or major headings -->
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.MilkLedger.HeadlineMedium</item>

    </style>

    <!-- ============================================== -->
    <!-- CUSTOM READABILITY TEXT STYLES (Dimensions must be defined in dimens.xml) -->
    <!-- ============================================== -->

    <style name="TextAppearance.MilkLedger.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <!-- Increase from default 16sp to 18sp -->
        <item name="android:textSize">@dimen/text_size_body_large_custom</item>
    </style>

    <style name="TextAppearance.MilkLedger.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <!-- Increase from default 22sp to 24sp and make bold for emphasis -->
        <item name="android:textSize">@dimen/text_size_title_large_custom</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.MilkLedger.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <!-- Increase size and add extra weight -->
        <item name="android:textSize">@dimen/text_size_headline_medium_custom</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>