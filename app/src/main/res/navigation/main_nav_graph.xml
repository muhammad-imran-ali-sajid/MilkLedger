<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nav_graph"
    app:startDestination="@id/dashboardFragment">

    <fragment
        android:id="@+id/purchaseListFragment"
        android:name="com.miassolutions.milkledger.features.purchase.list.MilkPurchaseListFragment"
        android:label="Purchases"
        tools:layout="@layout/fragment_milk_purchase_list">
        <action
            android:id="@+id/action_purchaseListFragment_to_purchaseFormFragment"
            app:destination="@id/purchaseFormFragment" />
        <action
            android:id="@+id/action_purchaseListFragment_to_supplierDetailFragment"
            app:destination="@id/supplierDetailFragment" />
        <argument
            android:name="workingDate"
            app:argType="long" />
    </fragment>
    <fragment
        android:id="@+id/expenseFragment"
        android:name="com.miassolutions.milkledger.features.expense.ui.list.ExpenseListFragment"
        android:label="Expenses"
        tools:layout="@layout/fragment_expenses">

        <action
            android:id="@+id/action_expenseFragment_to_expenseFormFragment"
            app:destination="@id/expenseFormFragment" />
        <action
            android:id="@+id/action_expenseFragment_to_editExpenseBottomSheet"
            app:destination="@id/editExpenseBottomSheet" />
        <argument
            android:name="workingDate"
            app:argType="long" />
    </fragment>
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.miassolutions.milkledger.features.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />
    <fragment
        android:id="@+id/devSettingsFragment"
        android:name="com.miassolutions.milkledger.zplayground.DevSettingsFragment"
        android:label="DevSettingsFragment"
        tools:layout="@layout/fragment_dev_settings" />
    <fragment
        android:id="@+id/driveBackupFragment"
        android:name="com.miassolutions.milkledger.features.backup.DriveBackupFragment"
        android:label="Backup/Restore"
        tools:layout="@layout/fragment_drive_backup" />
    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.miassolutions.milkledger.features.dashboard.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard">
        <action
            android:id="@+id/action_dashboardFragment_to_notesListFragment"
            app:destination="@id/notesListFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_cashflowFragment"
            app:destination="@id/cashflowFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_expenseFragment"
            app:destination="@id/expenseFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_milkSaleListFragment"
            app:destination="@id/milkSaleListFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_purchaseListFragment"
            app:destination="@id/purchaseListFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_ownerDashboardFragment"
            app:destination="@id/ownerDashboardFragment" />
    </fragment>
    <fragment
        android:id="@+id/supplierDetailFragment"
        android:name="com.miassolutions.milkledger.features.purchase.ui.supplierhistory.SupplierHistoryFragment"
        android:label="{supplierName}"
        tools:layout="@layout/fragment_supplier_history">
        <argument
            android:name="supplierName"
            app:argType="string" />
        <argument
            android:name="supplierId"
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/notesListFragment"
        android:name="com.miassolutions.milkledger.features.note.ui.list.NotesListFragment"
        android:label="Notes"
        tools:layout="@layout/fragment_notes_list">
        <action
            android:id="@+id/action_notesListFragment_to_addEditNoteFragment"
            app:destination="@id/addEditNoteFragment" />
    </fragment>
    <fragment
        android:id="@+id/addEditNoteFragment"
        android:name="com.miassolutions.milkledger.features.note.ui.form.NoteFormBottomSheet"
        android:label="Add New Note"
        tools:layout="@layout/bottom_sheet_note_form" />


    <fragment
        android:id="@+id/saleAddFragment"
        android:name="com.miassolutions.milkledger.features.sale.saleform.SaleFormFragment"
        android:label="Add Sales"
        tools:layout="@layout/fragment_add_sale">
        <argument
            android:name="saleId"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="saleDate"
            app:argType="long" />
    </fragment>
    <fragment
        android:id="@+id/accountListFragment"
        android:name="com.miassolutions.milkledger.features.account.list.AccountListFragment"
        android:label="Accounts"
        tools:layout="@layout/fragment_account_list">
        <action
            android:id="@+id/action_accountListFragment_to_accountFormFragment"
            app:destination="@id/accountFormFragment" />
    </fragment>
    <fragment
        android:id="@+id/accountFormFragment"
        android:name="com.miassolutions.milkledger.features.account.form.AccountFormFragment"
        android:label="Account Form"
        tools:layout="@layout/fragment_account_form">
        <argument
            android:name="accountId"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="type"
            app:argType="string"
            app:nullable="true" />
    </fragment>
    <fragment
        android:id="@+id/ownerSetupFragment"
        android:name="com.miassolutions.milkledger.features.owner.setup.OwnerSetupFragment"
        android:label="Owner Setup"
        tools:layout="@layout/fragment_owner_setup">
        <action
            android:id="@+id/action_ownerSetupFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/ownerSetupFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/expenseFormFragment"
        android:name="com.miassolutions.milkledger.features.expense.ui.form.ExpenseFormFragment"
        android:label="ExpenseFormFragment"
        tools:layout="@layout/fragment_add_expense">
        <argument
            android:name="selectedDate"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>
    <dialog
        android:id="@+id/editExpenseBottomSheet"
        android:name="com.miassolutions.milkledger.features.expense.ui.form.EditExpenseBottomSheet"
        android:label="EditExpenseBottomSheet"
        tools:layout="@layout/bottom_sheet_edit_expense">
        <argument
            android:name="expense"
            app:argType="com.miassolutions.milkledger.features.expense.domain.Expense" />
    </dialog>
    <fragment
        android:id="@+id/milkSaleListFragment"
        android:name="com.miassolutions.milkledger.features.sale.salelist.MilkSaleListFragment"
        android:label="@string/sales"
        tools:layout="@layout/fragment_milk_sale_list">
        <action
            android:id="@+id/action_milkSaleListFragment_to_saleAddFragment"
            app:destination="@id/saleAddFragment" />

        <action
            android:id="@+id/action_milkSaleListFragment_to_customerHistoryFragment"
            app:destination="@id/customerHistoryFragment" />
        <argument
            android:name="workingDate"
            app:argType="long" />
    </fragment>
    <fragment
        android:id="@+id/customerHistoryFragment"
        android:name="com.miassolutions.milkledger.features.sale.customerhistory.CustomerHistoryFragment"
        android:label="{customerName}'s History"
        tools:layout="@layout/fragment_customer_history">
        <argument
            android:name="customerId"
            app:argType="string" />
        <argument
            android:name="customerName"
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/purchaseFormFragment"
        android:name="com.miassolutions.milkledger.features.purchase.ui.form.PurchaseFormFragment"
        android:label="Purchase Form"
        tools:layout="@layout/fragment_purchase_form">
        <argument
            android:name="purchaseId"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="purchaseDate"
            app:argType="long" />
    </fragment>
    <fragment
        android:id="@+id/ownerDashboardFragment"
        android:name="com.miassolutions.milkledger.features.owner.dasboard.OwnerDashboardFragment"
        android:label="My Wallet"
        tools:layout="@layout/fragment_owner_dashboard" >
        <argument
            android:name="workingDate"
            app:argType="long" />
    </fragment>
    <fragment
        android:id="@+id/cashflowFragment"
        android:name="com.miassolutions.milkledger.features.cashflow.CashflowFragment"
        android:label="Cash Flow"
        tools:layout="@layout/fragment_cashflow" >
        <argument
            android:name="workingDate"
            app:argType="long" />
    </fragment>

</navigation>