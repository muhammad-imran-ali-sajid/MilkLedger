<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nav_graph"
    app:startDestination="@id/dashboardFragment">

    <fragment
        android:id="@+id/purchaseFragment"
        android:name="com.miassolutions.milkledger.features.purchase.ui.form.PurchaseFragment"
        android:label="Purchases"
        tools:layout="@layout/fragment_purchases" >
        <action
            android:id="@+id/action_purchaseFragment_to_supplierDetailFragment"
            app:destination="@id/supplierDetailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"

            />
        <action
            android:id="@+id/action_purchaseFragment_to_purchaseAddFragment"
            app:destination="@id/purchaseAddFragment" />
    </fragment>
    <fragment
        android:id="@+id/expenseFragment"
        android:name="com.miassolutions.milkledger.features.expense.ui.list.ExpenseFragment"
        android:label="Expenses"
        tools:layout="@layout/fragment_expenses" >
        <action
            android:id="@+id/action_expensesFragment_to_expenseAddEditFragment"
            app:destination="@id/expenseAddEditFragment" />
        <action
            android:id="@+id/action_expensesFragment_to_expenseEditBottomSheet"
            app:destination="@id/expenseEditBottomSheet" />
    </fragment>
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.miassolutions.milkledger.features.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />
    <fragment
        android:id="@+id/statsFragment"
        android:name="com.miassolutions.milkledger.features.cashflow.StatsFragment"
        android:label="Cash Flow"
        tools:layout="@layout/fragment_stats" />
    <fragment
        android:id="@+id/customersFragment"
        android:name="com.miassolutions.milkledger.features.customer.ui.list.CustomerListFragment"
        android:label="CustomersFragment"
        tools:layout="@layout/fragment_customers" >
        <action
            android:id="@+id/action_customersFragment_to_customerFormBottomSheetFragment"
            app:destination="@id/customerFormBottomSheetFragment" />
    </fragment>
    <dialog
        android:id="@+id/supplierFormBottomSheetFragment"
        android:name="com.miassolutions.milkledger.features.supplier.ui.form.SupplierFormBottomSheetFragment"
        android:label="SupplierFormBottomSheetFragment"
        tools:layout="@layout/supplier_form_layout" >
        <argument
            android:name="supplierId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </dialog>
    <dialog
        android:id="@+id/customerFormBottomSheetFragment"
        android:name="com.miassolutions.milkledger.features.customer.ui.form.CustomerFormBottomSheetFragment"
        android:label="CustomerFormBottomSheetFragment"
        tools:layout="@layout/customer_form_layout" >
        <argument
            android:name="customerId"
            app:argType="string"
            android:defaultValue="@null"
            app:nullable="true" />
    </dialog>
    <fragment
        android:id="@+id/suppliersFragment"
        android:name="com.miassolutions.milkledger.features.supplier.ui.suppliers.SupplierListFragment"
        android:label="SuppliersFragment"
        tools:layout="@layout/fragment_suppliers" >
        <action
            android:id="@+id/action_suppliersFragment_to_supplierFormBottomSheetFragment"
            app:destination="@id/supplierFormBottomSheetFragment" />
    </fragment>
    <fragment
        tools:layout="@layout/fragment_dev_settings"
        android:id="@+id/devSettingsFragment"
        android:name="com.miassolutions.milkledger.zplayground.DevSettingsFragment"
        android:label="DevSettingsFragment" />
    <fragment
        android:id="@+id/driveBackupFragment"
        tools:layout="@layout/fragment_drive_backup"
        android:name="com.miassolutions.milkledger.features.backup.DriveBackupFragment"
        android:label="DriveBackupFragment" />
    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.miassolutions.milkledger.features.dashboard.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard">
        <action
            android:id="@+id/action_dashboardFragment_to_statsFragment"
            app:destination="@id/statsFragment" />
    </fragment>
    <fragment
        android:id="@+id/customerDetailFragment"
        android:name="com.miassolutions.milkledger.features.sale.ui.saledetail.CustomerDetailFragment"
        android:label="{customerName}"
        tools:layout="@layout/fragment_customer_detail" >
        <argument
            android:name="customerId"
            app:argType="string" />
        <argument
            android:name="customerName"
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/supplierDetailFragment"
        tools:layout="@layout/fragment_supplier_detail"
        android:name="com.miassolutions.milkledger.features.purchase.ui.purchasedetail.SupplierDetailFragment"
        android:label="{supplierName}" >
        <argument
            android:name="supplierName"
            app:argType="string" />
        <argument
            android:name="supplierId"
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/notesListFragment"
        android:name="com.miassolutions.milkledger.features.note.ui.list.NotesListFragment"
        android:label="Notes"
        tools:layout="@layout/fragment_notes_list" >
        <action
            android:id="@+id/action_notesListFragment_to_addEditNoteFragment"
            app:destination="@id/addEditNoteFragment" />
    </fragment>
    <fragment
        android:id="@+id/addEditNoteFragment"
        android:name="com.miassolutions.milkledger.features.note.ui.form.NoteFormBottomSheet"
        android:label="Add New Note"
        tools:layout="@layout/bottom_sheet_note_form" />
    <fragment
        android:id="@+id/profitFragment"
        android:name="com.miassolutions.milkledger.features.profitwithdrawal.ProfitFragment"
        android:label="Profit History"
        tools:layout="@layout/fragment_profit" />
    <fragment
        android:id="@+id/expenseAddEditFragment"

        tools:layout="@layout/fragment_add_expense"
        android:name="com.miassolutions.milkledger.features.expense.ui.form.ExpenseAddBottomSheetFragment"
        android:label="Add Expenses" />
    <fragment
        android:id="@+id/purchaseAddFragment"
        android:name="com.miassolutions.milkledger.features.purchase.ui.form.PurchaseAddFragment"
        android:label="Add Purchases"
        tools:layout="@layout/fragment_add_purchase" />
    <fragment
        android:id="@+id/saleAddFragment"
        android:name="com.miassolutions.milkledger.features.sale.ui.saleform.SaleFormFragment"
        android:label="Add Sales"
        tools:layout="@layout/fragment_add_sale" >
        <argument
            android:name="saleId"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="saleDate"
            app:argType="long" />
    </fragment>
    <dialog
        tools:layout="@layout/bottomsheet_edit_expense"
        android:id="@+id/expenseEditBottomSheet"
        android:name="com.miassolutions.milkledger.features.expense.ui.form.ExpenseEditBottomSheet"
        android:label="ExpenseEditBottomSheet" />
    <fragment
        android:id="@+id/saleListFragment"
        android:name="com.miassolutions.milkledger.features.sale.ui.list.SaleListFragment"
        android:label="Sales"
        tools:layout="@layout/fragment_sales">
        <action
            android:id="@+id/action_saleListFragment_to_customerDetailFragment"
            app:destination="@id/customerDetailFragment" />
        <action
            android:id="@+id/action_saleListFragment_to_saleAddFragment"
            app:destination="@id/saleAddFragment" />
    </fragment>
    <fragment
        android:id="@+id/accountListFragment"
        android:name="com.miassolutions.milkledger.features.account.list.AccountListFragment"
        android:label="Accounts"
        tools:layout="@layout/fragment_account_list" >
        <action
            android:id="@+id/action_accountListFragment_to_accountFormFragment"
            app:destination="@id/accountFormFragment" />
    </fragment>
    <fragment
        android:id="@+id/accountFormFragment"
        tools:layout="@layout/fragment_account_form"
        android:name="com.miassolutions.milkledger.features.account.form.AccountFormFragment"
        android:label="AccountFormFragment" >
        <argument
            android:name="accountId"
            app:argType="string"
            app:nullable="true" />
    </fragment>
</navigation>