<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base Spacing Units (Use multiples of 8dp) -->
    <dimen name="spacing_micro">4dp</dimen>
    <dimen name="spacing_small">8dp</dimen>

    <!-- Standard Padding/Margin - Used on lists, cards, and general content -->
    <dimen name="spacing_medium">16dp</dimen>

    <!-- Large Section Margins - Used for margins around major UI elements -->
    <dimen name="spacing_large">24dp</dimen>

    <!-- Extra Large Margins - Used for screen-level padding or deep separation -->
    <dimen name="spacing_extra_large">32dp</dimen>

    <!-- Standard Corner Radius -->
    <dimen name="corner_radius_default">8dp</dimen>

    <!--
      Typography Sizing (Crucial for 50+ clients)
      We are explicitly increasing the font size for body and headline elements
      to ensure maximum legibility.
    -->
    <dimen name="text_size_body_large_custom">18sp</dimen>
    <dimen name="text_size_title_large_custom">24sp</dimen>
    <dimen name="text_size_headline_medium_custom">30sp</dimen>




    <!-- Spacing -->
    <dimen name="spacing_xs">4dp</dimen>
    <dimen name="spacing_s">8dp</dimen>
    <dimen name="spacing_m">16dp</dimen>
    <dimen name="spacing_l">24dp</dimen>
    <dimen name="spacing_xl">32dp</dimen>

    <!-- Font sizes -->
    <dimen name="sp_headline_large">24sp</dimen>
    <dimen name="sp_headline_medium">20sp</dimen>
    <dimen name="sp_title">18sp</dimen>
    <dimen name="sp_body">16sp</dimen>
    <dimen name="sp_caption">14sp</dimen>
    <dimen name="sp_button">16sp</dimen>

    <!-- Corner radius -->
    <dimen name="corner_small">4dp</dimen>
    <dimen name="corner_medium">8dp</dimen>
    <dimen name="corner_large">16dp</dimen>
    <dimen name="corner_xlarge">24dp</dimen>

    <!-- Elevation -->
    <dimen name="elevation_low">2dp</dimen>
    <dimen name="elevation_medium">4dp</dimen>
    <dimen name="elevation_high">8dp</dimen>
</resources>
