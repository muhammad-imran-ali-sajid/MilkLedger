<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Canonical MilkLedger typography scale -->
    <style name="TextAppearance.MilkLedger.ScreenTitle" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">26sp</item>
        <item name="lineHeight">34sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.MilkLedger.SectionTitle" parent="TextAppearance.Material3.TitleLarge">
