<?xml version="1.0" encoding="utf-8"?>
<resources>


    <!-- Style for all label TextViews -->
    <style name="TextLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#000</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Style for all value TextViews -->
    <style name="TextValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#000</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Special style for Urdu title (Price, Paid, Balance labels) -->
    <style name="TextTitleUrdu" parent="TextLabel">
        <item name="android:textSize">20sp</item>
        <item name="fontFamily">@font/mehr_nastaleeq</item>
        <item name="android:textColor">#000</item>
    </style>

    <!-- Notes style -->
    <style name="TextNote">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#444444</item>
        <item name="android:gravity">start</item>
        <item name="android:paddingTop">4dp</item>
    </style>


    <!-- Buttons -->
    <style name="Button.Filled" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/corner_medium</item>
        <item name="textAppearanceButton">@style/Text.Button</item>
        <item name="elevation">@dimen/elevation_high</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/md_theme_primary</item>

    </style>

    <style name="Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textColor">@color/md_theme_onSecondary</item>
    </style>

    <!-- Cards -->
    <style name="Card.Filled" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/corner_medium</item>
        <item name="cardElevation">@dimen/elevation_low</item>

    </style>

    <style name="Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/corner_large</item>
    </style>

    <!-- Inputs -->
    <style name="TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/corner_medium</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_medium</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_medium</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_medium</item>
    </style>


    <style name="NavActiveIndicator" parent="">
        <item name="android:background">@drawable/bg_circle</item> <!-- background color -->
    </style>

    <style name="BottomNavigationStyle" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="dashboard_element_style">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="dashboard_card">
        <item name="android:clickable">true</item>
        <item name="android:backgroundTint">@color/white</item>
        <item name="strokeColor">@color/white</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">6dp</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="purchase_card">
        <item name="cardBackgroundColor">#E2E8EB</item>
        <item name="strokeColor">#E2E8EB</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">6dp</item>
    </style>





        <!-- Theme overlay for DatePicker dialogs -->
        <style name="ThemeOverlay.MyApp.DatePicker"
            parent="ThemeOverlay.Material3.MaterialCalendar">

            <!-- Primary brand color for selected day etc. -->
            <item name="colorPrimary">@color/md_theme_onPrimary</item>
            <item name="colorOnPrimary">@color/md_theme_onPrimary</item>

            <!-- Surface color for calendar background -->
            <item name="colorSurface">@color/md_theme_onSurface</item>
            <item name="colorOnSurface">@color/md_theme_onSurface</item>

            <!-- Range fill / highlight color if you use date‑range picker -->
            <item name="rangeFillColor">@color/md_theme_primary</item>

<!--            &lt;!&ndash; Header title text appearance &ndash;&gt;-->
