<!--            &lt;!&ndash; Day selector text appearance &ndash;&gt;-->
<!--            <item name="materialCalendarDayTextAppearance">@style/TextAppearance.MyApp.DatePicker.Day</item>-->
        </style>

        <!-- TextAppearance examples -->
        <style name="TextAppearance.MyApp.DatePicker.HeaderTitle"
            parent="TextAppearance.Material3.HeadlineSmall">
            <item name="android:textColor">@color/md_theme_onSurface</item>
        </style>

        <style name="TextAppearance.MyApp.DatePicker.Year"
            parent="TextAppearance.Material3.BodyLarge">
            <item name="android:textColor">@color/md_theme_onSurface</item>
        </style>

        <style name="TextAppearance.MyApp.DatePicker.Day"
            parent="TextAppearance.Material3.BodyMedium">
            <item name="android:textColor">@color/md_theme_onSurface</item>
        </style>




</resources>