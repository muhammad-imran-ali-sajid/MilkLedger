<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MilkLedger" parent="Theme.Material3.DynamicColors.Light.NoActionBar">

        <!-- Brand Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="android:textColor">@color/textview_text_color</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>

<!--         Surface Colors (High Contrast) -->
        <item name="colorSurface">@color/surface</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>

         Status Bar Color (Use primary color for brand consistency)
        <item name="android:statusBarColor">?attr/colorPrimary</item>







    </style>

    <style name="Theme.MilkLedger" parent="Base.Theme.MilkLedger" />

    <style name="Theme.Launcher" parent="Theme.MilkLedger"/>
    <style name="Theme.Auth" parent="Theme.MilkLedger"/>




</resources>